{
    "tasks": [
        {
            "id": "task1",
            "name": "INQ transmits the transaction data request",
            "type": "Service"
        },
        {
            "id": "task2",
            "name": "IP checks the request",
            "type": "Service"
        },
        {
            "id": "task3",
            "name": "IP answers the question",
            "type": "Service"
        }
    ],
    "events": [
        {
            "id": "startEvent1",
            "name": "start",
            "type": "StartNoneEvent"
        },
        {
            "id": "endEvent1",
            "name": "end",
            "type": "EndNoneEvent"
        }
    ],
    "gateways": [
        {
            "id": "gateway1",
            "name": "Check request outcome",
            "type": "Exclusive"
        }
    ],
    "pools": [
        {
            "id": "pool1",
            "name": "INQ",
            "lanes": [
                {
                    "id": "lane1",
                    "name": "INQ Lane",
                    "elemRefs": [
                        "task1",
                        "startEvent1"
                    ]
                }
            ]
        },
        {
            "id": "pool2",
            "name": "IP",
            "lanes": [
                {
                    "id": "lane2",
                    "name": "IP Lane",
                    "elemRefs": [
                        "task2",
                        "task3",
                        "gateway1",
                        "endEvent1"
                    ]
                }
            ]
        }
    ],
    "sequenceFlows": [
        {
            "id": "seqFlow1",
            "sourceRef": "startEvent1",
            "targetRef": "task1"
        },
        {
            "id": "seqFlow2",
            "sourceRef": "task1",
            "targetRef": "task2"
        },
        {
            "id": "seqFlow3",
            "sourceRef": "task2",
            "targetRef": "gateway1"
        },
        {
            "id": "seqFlow4",
            "sourceRef": "gateway1",
            "targetRef": "task3"
        },
        {
            "id": "seqFlow5",
            "sourceRef": "task3",
            "targetRef": "endEvent1"
        }
    ],
    "messageFlows": [
        {
            "id": "msgFlow1",
            "sourceRef": "task1",
            "targetRef": "task2"
        },
        {
            "id": "msgFlow2",
            "sourceRef": "task2",
            "targetRef": "task3"
        }
    ]
}