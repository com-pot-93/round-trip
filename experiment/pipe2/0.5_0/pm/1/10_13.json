            "type": "StartNoneEvent"
        },
        {
            "id": "event2",
            "name": "end",
            "type": "EndNoneEvent"
        }
    ],
    "gateways": [
        {
            "id": "gateway1",
            "name": "Check outcome",
            "type": "Exclusive"
        }
    ],
    "pools": [
        {
            "id": "pool1",
            "name": "INQ",
            "lanes": [
                {
                    "id": "lane1",
                    "name": "INQ Lane",
                    "elemRefs": [
                        "task1",
                        "task3"
                    ]
                }
            ]
        },
        {
            "id": "pool2",
            "name": "IP",
            "lanes": [
                {
                    "id": "lane2",
                    "name": "IP Lane",
                    "elemRefs": [
                        "task2",
