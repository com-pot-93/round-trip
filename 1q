colours = [['#8ff0a4','#26a269'],['#99c1f1','#1a5fb4'],['#ffa8db','#f35eb5'],['#dc8add','#813d9c']]
colours = [['#99c1f1','#1a5fb4'],['#ffa8db','#f35eb5'],['#dc8add','#813d9c']]
if 'm2m' in file_name:
    columns = ['m2m_eval_1','m2m_eval_2']
    names = ['Model Similarity Scores (1)','Model Similarity Scores (2)']
else:
    columns = ['t2t_eval_1','t2t_eval_2']
    names = ['Text Similarity Score (1)','Text Similarity Scores (2)']


for c in range(0,len(columns)):
    df = pd.DataFrame()

#    t2t_eval_1 = csv_file_two[['model_name', columns[c]]]
#    final = t2t_eval_1.groupby('model_name')
#    for key, item in final:
#        temp = final.get_group(key).reset_index()
#        df[key] = temp[columns[c]]

    col = csv_file[['model_name', columns[c]]]
    collist = csv_file[columns[c]].tolist()
    inter = st.t.interval(confidence=0.95, df=len(collist)-1, loc=np.mean(collist), scale=st.sem(collist))
    mymean = np.mean(collist)
    final = col.groupby('model_name')
    for key, item in final:
        temp = final.get_group(key).reset_index()
        df[key] = temp[columns[c]]

    palette = sns.blend_palette(colours[c], n_colors=5)
    plt.figure(figsize=(18, 14))
    ax = sns.boxplot(data=df, palette=palette)
    ax = sns.swarmplot(data=df, color=".25", size = 4)
    # Add confidence intervals (uncomment these lines to add CI)
    plt.axhline(mymean, c='#cb4335', linestyle='--', label=f'Mean: {inter[0]:.2f}')
    #plt.axhline(inter[0], c='#909497', linestyle='--', label=f'CI Lower: {inter[0]:.2f}')
    #plt.axhline(inter[1], c='#909497', linestyle='--', label=f'CI Upper: {inter[1]:.2f}')
    #plt.axhline(inter[0], c='r')
    #plt.axhline(inter[1], c='r')
    #plt.plot([], [ci[0], ci[1]], color="red", lw=2)
    plt.legend()
    plt.ylim(0, 1)
    plt.rcParams["figure.dpi"] = 300
    plt.xlabel("Domains", size=12)
    plt.xticks(fontsize=8)
    plt.ylabel('{} - {}'.format(names[c],llm.upper()), size=12)
    plt.margins(0.05)
    plt.savefig('pics/{} - {}.png'.format(names[c],llm.upper()))
    plt.savefig('pics/{} - {}.pdf'.format(names[c],llm.upper()))

